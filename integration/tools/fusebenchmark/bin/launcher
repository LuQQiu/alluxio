SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")"; pwd)"

get_env() {
  DEFAULT_LIBEXEC_DIR="${SCRIPT_DIR}"/../../../../libexec
  ALLUXIO_LIBEXEC_DIR=${ALLUXIO_LIBEXEC_DIR:-${DEFAULT_LIBEXEC_DIR}}
  . ${ALLUXIO_LIBEXEC_DIR}/alluxio-config.sh

  ALLUXIO_FUSE_JAR=${SCRIPT_DIR}/../../../fuse/target/alluxio-integration-fuse-${VERSION}-jar-with-dependencies.jar
  ALLUXIO_FUSE_BENCHMARK_JAR=${SCRIPT_DIR}/../target/alluxio-integration-tools-fusebenchmark-${VERSION}-jar-with-dependencies.jar
  CLASSPATH=${CLASSPATH}:${ALLUXIO_FUSE_JAR}
  CLASSPATH=${CLASSPATH%:}
  CLASSPATH=${CLASSPATH#:}
  CLASSPATH=${CLASSPATH}:${ALLUXIO_FUSE_BENCHMARK_JAR}
  CLASSPATH=${CLASSPATH%:}
  CLASSPATH=${CLASSPATH#:}
}

get_env


cmd="${JAVA} -cp ${CLASSPATH} -Dalluxio.dora.client.ufs.root=/local2 -Dalluxio.master.embedded.journal.addresses=FuseBasic-worker-0:19200  -Dalluxio.master.hostname=FuseBasic-worker-0 -Dalluxio.master.journal.type=EMBEDDED -Dalluxio.user.short.circuit.enabled=false -Dalluxio.user.file.passive.cache.enabled=false -Dalluxio.dora.client.read.location.policy.enabled=true -Dalluxio.dora.client.ufs.root=/local2/ -Dalluxio.user.netty.data.transmission.enabled=true -Dalluxio.user.file.metadata.sync.interval=100000000   alluxio.fuse.TestMain $@"
exec ${cmd}

